+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+pub struct Verification {
+    pub detail: Option<Value>,
+    pub error: Option<String>,
+    pub complete: Option<bool>,
+}
+
+impl Verification {
+    pub fn from_result(result: Result<Value, String>) -> Self {
+        match result {
+            Ok(detail) => {
+                // An explicit failure wins over a contradictory top-level flag.
+                let failed = detail
+                    .get("reasonList")
+                    .and_then(Value::as_array)
+                    .map(|rows| {
+                        rows.iter()
+                            .any(|r| r.get("complete").and_then(Value::as_bool) == Some(false))
+                    })
+                    .unwrap_or(false);
+                let complete = if failed {
+                    Some(false)
+                } else {
+                    detail.get("complete").and_then(Value::as_bool)
+                };
+                Self {
+                    complete,
+                    detail: Some(detail),
+                    error: None,
+                }
+            }
+            Err(error) => Self {
+                detail: None,
+                complete: None,
+                error: Some(error),
+            },
+        }
+    }
+    pub fn label(&self) -> &'static str {
+        match self.complete {
+            Some(true) => "达标",
+            Some(false) => "未达标",
+            None => "未知",
+        }
+    }
 }
 
